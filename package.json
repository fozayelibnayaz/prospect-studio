{
  "name": "prospect-studio",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 4180",
    "test": "node --test tests/*.test.js",
    "deploy": "node scripts/check-deploy.mjs && wrangler deploy --env production",
    "check": "node --check src/worker.js && node --check public/app.js && npm test",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "1.58.1",
    "prettier": "^3.6.2",
    "wrangler": "4.86.0",
    "miniflare": "4.20260426.0"
  }
}
